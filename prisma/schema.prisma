// CHERY AI Assistant — Schema Prisma
// Koresponn ak estrikti baz done ki nan CHERY-AI-Plan-Pwoje.docx

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum MessageSender {
  USER
  AI
}

model User {
  id           String             @id @default(uuid())
  name         String
  email        String             @unique
  passwordHash String
  plan         SubscriptionPlan   @default(FREE)
  createdAt    DateTime           @default(now())
  languagePref String             @default("ht")

  conversations   Conversation[]
  generatedImages GeneratedImage[]
  generatedVideos GeneratedVideo[]
  progress        UserProgress[]
  subscriptions   Subscription[]

  @@map("users")
}

model Conversation {
  id           String    @id @default(uuid())
  userId       String
  title        String    @default("Nouvo konvèsasyon")
  createdAt    DateTime  @default(now())
  lastActivity DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  sender         MessageSender
  content        String        @db.Text
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model GeneratedImage {
  id        String   @id @default(uuid())
  userId    String
  prompt    String   @db.Text
  style     String   @default("realistic")
  imageUrl  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("generated_images")
}

model GeneratedVideo {
  id        String   @id @default(uuid())
  userId    String
  prompt    String   @db.Text
  status    String   @default("pending") // pending | processing | completed | failed
  videoUrl  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("generated_videos")
}

model Course {
  id          String   @id @default(uuid())
  title       String
  description String
  level       String   @default("debutan")
  category    String   @default("jeneral")
  createdAt   DateTime @default(now())

  lessons  Lesson[]
  progress UserProgress[]

  @@map("courses")
}

model Lesson {
  id         String @id @default(uuid())
  courseId   String
  title      String
  contentUrl String
  order      Int    @default(0)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

model UserProgress {
  id               String   @id @default(uuid())
  userId           String
  courseId         String
  progressPercent  Int      @default(0)
  lastAccessedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("user_progress")
}

model BusinessTool {
  id          String @id @default(uuid())
  name        String
  description String

  @@map("business_tools")
}

model Subscription {
  id        String           @id @default(uuid())
  userId    String
  plan      SubscriptionPlan
  status    String           @default("active") // active | cancelled | expired
  startedAt DateTime         @default(now())
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}
